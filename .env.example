# ── ParkSpot AI — backend environment (placeholders only — NEVER commit real keys) ──
# Copy to `.env` on the BACKEND machine only. `.env` is git-ignored.
# Nothing in this file belongs in frontend code, HTML, JS bundles, or API responses.

# ── Muse Spark / Meta model API ──────────────────────────────────────────────
# Chat Completions with tool calling.
# MODEL_API_KEY: your Meta Model API key (backend only). META_BASE_URL: the
# Meta Model API base (default shown). MUSE_SPARK_MODEL: documented chat
# model identifier (muse-spark-1.3 default; muse-spark-1.2 / muse-spark-1.1
# also documented) — leave unset to use the default.
MODEL_API_KEY=sk-REPLACE_ME
META_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# ── SAM 3.1 vision (self-hosted) ────────────────────────────────────────────
# Meta ships SAM 3/3.1 as open weights (github.com/facebookresearch/sam3,
# huggingface.co/facebook/sam3). There is NO Meta-hosted SAM API key:
# deploy the weights to your own inference service and point this at it.
# The service must accept POST /segment (multipart: image, prompts, model)
# and return {"detections":[{"label","score","box":{"x","y","w","h"}}]}.
SAM_SERVICE_URL=
SAM_MODEL=
SAM_SERVICE_API_KEY=

# ── Muse Voice Transcribe (optional, OFF by default) ────────────────────────
# Voice search via the Meta Model API transcription endpoint
# (POST {META_VOICE_BASE_URL}/asr/transcribe, multipart: request JSON +
# WAV audio). Recordings are capped short, converted to mono 16 kHz WAV
# with FFmpeg on the backend when needed, and never stored or logged.
# REQUIRES FFmpeg installed on the backend machine (system package, not
# pip): sudo apt-get install ffmpeg  /  brew install ffmpeg. Without it,
# non-WAV browser recordings fail honestly and voice stays unavailable.
MUSE_VOICE_ENABLED=false
META_VOICE_API_KEY=
META_VOICE_BASE_URL=https://api.meta.ai/v1
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
MUSE_VOICE_MAX_SECONDS=30
MUSE_VOICE_MAX_UPLOAD_MB=10

# ── GPS nearby search ───────────────────────────────────────────────────────
NEARBY_SEARCH_DEFAULT_RADIUS_KM=5
NEARBY_SEARCH_MAX_RADIUS_KM=50

# ── Inventory / auth source of truth (existing Supabase project) ────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ── Hardening knobs (optional) ──────────────────────────────────────────────
META_TIMEOUT_S=30
META_MAX_RETRIES=2
META_TOTAL_TIMEOUT_S=90
META_RATE_LIMIT_PER_MINUTE=30
OCR_MIN_CONFIDENCE=0.6
META_CORS_ORIGINS=*
